APP_URL=https://bokodigital-inventory-planner.vercel.app
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Add read_all_orders (needs Shopify approval for public apps) to allow lookbacks beyond 60 days
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_locations
DATABASE_URL=
RESEND_API_KEY=
EMAIL_FROM="Boko Inventory Planner <notifications@boko.com.au>"
ENCRYPTION_KEY=
CRON_SECRET=
# Optional: enables the AI-written "What's selling" summary. Without it a rule-based summary is shown.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
